# Пример .env. Скопируйте в .env и подставьте реальные значения.
# Не коммитьте .env с реальными данными.

# --- База данных (Tortoise ORM) ---
DATABASE_WEB_URL=postgres://<user>:<password>@db:5432/<db_name>
DATABASE_SCHEDULER_URL=postgres://<user>:<password>@db:5432/<db_name>

# --- Контейнер PostgreSQL (docker-compose.yaml) ---
POSTGRES_DB=<db_name>
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>

# --- Docker compose ---
# Внешний порт веб-API
PORT=8000
# Тег образов; на сервере выставляется автоматически при деплое
TAG=<image-tag>

# --- Доступ к API (заголовок X-API-Key) ---
API_KEY=<api-key>

# --- SVS ---
URL_SVS_GET=https://<svs-host>/<get-orders-path>
URL_SVS_SET=https://<svs-host>/<set-status-path>
USER_KEY=<svs-user-key>
TOKEN=<svs-token>

# --- Страницы отслеживания перевозчиков ---
URL_ARSEXPRESS=<tracking-url>
URL_AVIS_LOGISTICS=<tracking-url>
URL_TYUMEN=<tracking-url>
URL_EKATERINBURG=<tracking-url>
URL_SIB_EXPRESS=<tracking-url>
URL_PLEX_POST=<tracking-url>
URL_BIZON=<tracking-url>
URL_RASTOYANIYA=<tracking-url>
URL_VIP_MAIL_UFA=<tracking-url>
URL_POST_MASTER=<tracking-url>

# --- Telegram-уведомления через Notification Service ---
# true/1/yes/on — включено; иначе выключено (по умолчанию false)
NOTIFICATION_SERVICE_ENABLED=false
NOTIFICATION_SERVICE_URL=https://<notification-service-host>
NOTIFICATION_SERVICE_API_KEY=<notification-service-api-key>
BOT_TOKEN=<telegram-bot-token>
# Целое число, например -1001234567890
CHAT_ID=<telegram-chat-id>
